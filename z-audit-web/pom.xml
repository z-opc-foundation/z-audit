<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-audit</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-audit-web</artifactId>
    <name>审计与合规留痕 :: web</name>
    <packaging>jar</packaging>

    <description>审计与合规留痕：审计事件模型 + 事件出口 SPI（落库/日志/外部）+ 留存期策略（web：/api/audit/** REST 管控面 + AutoConfiguration 装配）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-audit-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 引擎装配 + 本域数据源在 starter 里（M2 #23：引擎装配只有一处，web 不重复定义）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-audit-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ModuleDataSourceTemplate 所在：z.base.db.* 键名模式的权威实现。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MybatisSqlSessionFactoryBean（本域 sqlSessionFactory 装配用）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 本地夹具库：DDL 幂等与接口可路由两个验收项都在 H2 上跑，不连任何真实库。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
